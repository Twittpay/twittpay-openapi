{
  "info": {
    "name": "TwittPay API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://checkout.twittpay.com" },
    { "key": "brand_key", "value": "YOUR_BRAND_KEY" },
    { "key": "transaction_id", "value": "" }
  ],
  "item": [
    {
      "name": "Create a payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "API-KEY", "value": "{{brand_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cus_name\": \"John Doe\",\n  \"cus_email\": \"john@example.com\",\n  \"amount\": \"10.00\",\n  \"success_url\": \"https://example.com/success\",\n  \"cancel_url\": \"https://example.com/cancel\",\n  \"metadata\": { \"order_id\": \"1001\" }\n}"
        },
        "url": { "raw": "{{base_url}}/api/payment/create", "host": ["{{base_url}}"], "path": ["api", "payment", "create"] }
      }
    },
    {
      "name": "Verify a payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "API-KEY", "value": "{{brand_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaction_id\": \"{{transaction_id}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/payment/verify", "host": ["{{base_url}}"], "path": ["api", "payment", "verify"] }
      }
    }
  ]
}
